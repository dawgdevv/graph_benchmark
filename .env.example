COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=

# Neo4j Aura Free — https://console.neo4j.io
# URI looks like neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Memgraph Cloud — https://cloud.memgraph.com
# URI looks like bolt+ssc://<host>:7687
MEMGRAPH_URI=
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph

# FalkorDB Cloud — https://app.falkordb.cloud
# Connection string looks like falkor://<username>@<host>:<port> (native RESP, no TLS).
# You may also set FALKORDB_PASSWORD to inject the password into the URI.
# FALKORDB_DATABASE is the FalkorDB graph name.
FALKORDB_URI=
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
FALKORDB_DATABASE=falkordb

# SurrealDB Cloud — https://app.surrealdb.com
# URL looks like wss://<instance>.surreal.cloud
SURREAL_URL=
SURREAL_NAMESPACE=benchmark
SURREAL_DATABASE=wikivote
SURREAL_USERNAME=
SURREAL_PASSWORD=
